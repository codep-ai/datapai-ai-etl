      "surrogate_key": null,
      "scd_type": null,
      "foreign_keys": [],
      "measures": [],
      "columns": [],
      "logic": "with spine as (select date_day from (select min(trade_date) as sd, max(trade_date) as ed from stg_prices), lateral (select dateadd(day, seq4(), sd) as date_day from table(generator(rowcount => 10000))) where date_day <= ed) select s.date_day, e.exchange, case when c.closed_date is null and dayname(s.date_day) not in ('Sat', 'Sun') then true else false end as is_trading_day from spine s cross join (select distinct exchange from stg_prices) e left join stg_closed_dates c on s.date_day = c.closed_date and e.exchange = c.market_code",
      "tests": [
