    {
      "name": "int_price_with_indicators",
      "layer": "intermediate",
      "description": "Price grain with technical indicators and OBV.",
      "sources": [],
      "refs": [
        "stg_prices",
        "stg_fx_rates",
        "stg_exchange_ref"
      ],
      "grain": [
        "ticker",
        "exchange",
        "trade_date"
      ],
      "natural_key": [],
      "surrogate_key": null,
      "scd_type": null,
      "foreign_keys": [],
      "measures": [
        "sma_5",
        "sma_200",
        "rsi_14",
        "obv_trend"
      ],
      "columns": [],
      "logic": "join stg_prices p join stg_exchange_ref e on p.exchange=e.exchange left join stg_fx_rates fx on e.currency_code=fx.quote_currency and p.trade_date=fx.trade_date; close_usd = p.close / coalesce(fx.rate, last_value(fx.rate) over (partition by e.currency_code order by p.trade_date rows between unbounded preceding and current row)); indicators per (ticker, exchange) order by trade_date: sma_N = avg(close) over trailing N rows; volatility_20d = stddev(ln(close/nullif(lag(close),0))) over 20 rows * sqrt(252) * 100; rsi_14 = 100 - (100 / (1 + (avg(case when close>lag(close) then close-lag(close) else 0 end) over 14 rows / nullif(avg(case when close<lag(close) then lag(close)-close else 0 end) over 14 rows, 0)))); macd_line = ema(close, 12) - ema(close, 26); macd_signal = ema(macd_line, 9); obv = sum(case when close > lag(close) then volume when close < lag(close) then -volume else 0 end) over unbounded preceding; obv_trend = case when (obv - lag(obv, 10)) > 0 then 'UP' when (obv - lag(obv, 10)) < 0 then 'DOWN' else 'FLAT' end; pivot_pp = (lag(high)+lag(low)+lag(close))/3; kdj_k = sma((close-min(low,9) over 9 rows)/(nullif(max(high,9) over 9 rows - min(low,9) over 9 rows, 0))*100, 3)",
      "tests": [
        {
          "type": "unique_combination_of_columns",
          "column": null,
          "columns": [
            "ticker",
            "exchange",
            "trade_date"
          ],
          "values": null,
          "to": null,
          "field": null
        }
      ],
      "materialized": "table",
