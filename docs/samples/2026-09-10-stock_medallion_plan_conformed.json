      "natural_key": [],
      "surrogate_key": null,
      "scd_type": null,
      "foreign_keys": [],
      "measures": [
        "sma_5",
        "rsi_14",
        "macd_line",
        "obv_trend"
      ],
      "columns": [],
      "logic": "join stg_prices p join stg_exchange_ref e on p.exchange=e.exchange left join stg_fx_rates fx on e.currency_code=fx.quote_currency and p.trade_date=fx.trade_date; close_usd = p.close / last_value(fx.rate ignore nulls) over (partition by e.currency_code order by p.trade_date); indicators: sma_n = avg(close) over (partition by ticker, exchange order by trade_date rows n-1 preceding); volatility_20d = stddev(ln(close/lag(close))) over (partition by ticker, exchange order by trade_date rows 19 preceding) * sqrt(252) * 100; rsi_14 = 100 - (100 / (1 + (avg(nullif(change,0)) filter (where change>0) / avg(abs(nullif(change,0))) filter (where change<0)))); obv = sum(case when close > lag(close) then volume when close < lag(close) then -volume else 0 end) over (partition by ticker, exchange order by trade_date rows unbounded preceding); obv_trend = case when (obv - lag(obv, 10)) > 0 then 'UP' when (obv - lag(obv, 10)) < 0 then 'DOWN' else 'FLAT' end; pivot_pp = (lag(high)+lag(low)+lag(close))/3.",
      "tests": [
        {
          "type": "unique_combination_of_columns",
          "column": null,
          "columns": [
            "ticker",
            "exchange",
            "trade_date"
          ],
