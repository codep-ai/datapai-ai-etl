    {
      "name": "int_price_with_indicators",
      "layer": "intermediate",
      "description": "Technical indicators, grain: ticker, exchange, trade_date.",
      "sources": [],
      "refs": [
        "stg_prices",
        "stg_fx_rates",
        "stg_exchange_ref"
